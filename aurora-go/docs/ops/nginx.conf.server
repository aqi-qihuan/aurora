events {
    worker_connections 1024;
}

http {
    resolver 127.0.0.11 valid=10s ipv6=off;
    include       mime.types;
    default_type  application/octet-stream;
    
    # ⭐ 获取真实客户端IP配置（解决Docker环境中获取到127.0.0.1的问题）
    # 信任所有来源的请求（如果有CDN，需要改为CDN的IP段）
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    
    sendfile        on;
    keepalive_timeout  65;

    client_max_body_size     50m;
    client_body_buffer_size  10m;
    client_header_timeout    1m;
    client_body_timeout      1m;

    gzip on;
    gzip_min_length 1k;
    gzip_buffers     4 16k;
    gzip_comp_level 4;
    gzip_types text/plain application/javascript application/x-javascript text/css application/xml text/javascript application/x-httpd-php image/jpeg image/gif image/png;
    gzip_vary on;

    # SSL配置
    ssl_session_timeout 5m;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # HTTP到HTTPS重定向 (通用配置)
    server {
        listen       80;
        server_name  aqi125.cn www.aqi125.cn admin.aqi125.cn ws.aqi125.cn link.aqi125.cn minio.aqi125.cn dai.aqi125.cn;
        return 301 https://$host$request_uri;
    }

    # 主站配置
    server {
        listen  443 ssl;
        server_name  aqi125.cn www.aqi125.cn;

        ssl_certificate /etc/nginx/cert/aqi125.cn_bundle.pem;
        ssl_certificate_key /etc/nginx/cert/aqi125.cn.key;

        location / {
            root   /usr/share/nginx/blog;
            index  index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            set $up_ago aurora-go:8080; proxy_pass http://$up_ago;

            # 代理头设置
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 超时设置
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_intercept_errors on;
        }
    }

    # 管理后台配置
    server {
        listen  443 ssl;
        server_name  admin.aqi125.cn;

        ssl_certificate /etc/nginx/cert/admin.aqi125.cn_bundle.pem;
        ssl_certificate_key /etc/nginx/cert/admin.aqi125.cn.key;

        location / {
            root   /usr/share/nginx/admin;
            index  index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            set $up_ago aurora-go:8080; proxy_pass http://$up_ago;

            # 代理头设置
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 超时设置
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_intercept_errors on;
        }
    }

    # WebSocket服务配置
    server {
        listen  443 ssl;
        server_name  ws.aqi125.cn;

        ssl_certificate /etc/nginx/cert/ws.aqi125.cn_bundle.pem;
        ssl_certificate_key /etc/nginx/cert/ws.aqi125.cn.key;

        location / {
            set $up_mio aurora-minio:9000; rewrite ^(.*)$ /aurora$1 break; proxy_pass http://$up_mio;

            # 代理头设置
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 超时设置
            proxy_connect_timeout 30s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_intercept_errors on;
             # WebSocket支持
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }

    # dai.aqi125.cn 配置
    server {
        listen  443 ssl;
        server_name  dai.aqi125.cn;

        ssl_certificate /etc/nginx/cert/dai.aqi125.cn_bundle.pem;
        ssl_certificate_key /etc/nginx/cert/dai.aqi125.cn.key;

        access_log /var/log/nginx/dai.access.log;
        error_log /var/log/nginx/dai.error.log;

        location / {
            proxy_pass http://129.226.195.114:5800;

            # 代理头设置
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 超时设置
            proxy_connect_timeout 1m;
            proxy_send_timeout 1m;
            proxy_read_timeout 1m;
            proxy_intercept_errors on;
        }
    }
    include /etc/nginx/conf.d/*.conf;
}
